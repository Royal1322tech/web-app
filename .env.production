VITE_API_BASE_URL=https://staging-api.royalis.tech

# The deployed image (staging) uses real partner sign-in. Local development (.env.development) and
# the demo test build keep the demo login.
VITE_AUTH_MODE=api
# Login requires the company ID; until companies are identified another way, users enter it.
VITE_AUTH_COMPANY_ID_ENTRY=true
# Hotel search sends real searches to POST /api/v1/b2b/hotels/search with the signed-in company's
# token. It needs VITE_AUTH_MODE=api; the search page is only reachable after sign-in.
VITE_HOTEL_SEARCH_MODE=api
